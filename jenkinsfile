pipeline {
    agent any

    environment{
        REGISTRY_USER = '

    stages {


        stage('Install Dependencies') {
            steps {
                sh 'pip3 install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python3 -m pytest'
            }
        }

        stage('Package') {
            steps {
                sh 'tar -cvf hello-devops.tar .'
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'hello-devops.tar', fingerprint: true
            }
        }
    }
}
